# Supabase configuration for Topclues Doctor Hub
# Copy to .env.local and fill in your project values.

# Public Supabase project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Public anon/publishable key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_ANON_KEY"

# Service role key (server-only - NEVER expose in client code)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Optional: direct Postgres connection string (used by supabase CLI tooling)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Optional: Supabase access token for CLI / management operations
SUPABASE_ACCESS_TOKEN="YOUR_SUPABASE_ACCESS_TOKEN"

# Set to "true" to disable webpack hot module replacement in dev
DISABLE_HMR="false"
